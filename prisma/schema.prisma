generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Incident {
  id            String         @id @default(uuid()) @db.Uuid
  referenceCode String         @unique
  title         String
  description   String?
  status        IncidentStatus @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
