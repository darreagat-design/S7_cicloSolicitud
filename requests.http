@baseUrl = http://localhost:3000

### List incidents
GET {{baseUrl}}/incidents

### List categories
GET {{baseUrl}}/categories

### Create incident
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "referenceCode": " inc-100 ",
  "title": " Falla de conectividad ",
  "description": "No hay conexion en recepcion",
  "status": "OPEN",
  "categoryCode": " network "
}

### Create incident with missing category
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "referenceCode": "inc-101",
  "title": "Categoria inexistente",
  "description": "Debe responder 404",
  "status": "OPEN",
  "categoryCode": "unknown"
}

### Create duplicated incident
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "referenceCode": "inc-100",
  "title": "Referencia duplicada",
  "description": "Debe responder 409",
  "status": "OPEN",
  "categoryCode": "network"
}

### Create incident with invalid status
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "referenceCode": "inc-102",
  "title": "Estado invalido",
  "description": "Debe responder 400",
  "status": "PENDING",
  "categoryCode": "network"
}

### Create incident with forbidden categoryId
POST {{baseUrl}}/incidents
Content-Type: application/json

{
  "referenceCode": "inc-103",
  "title": "Propiedad no permitida",
  "description": "Debe responder 400 por forbidNonWhitelisted",
  "status": "OPEN",
  "categoryCode": "network",
  "categoryId": "00000000-0000-4000-8000-000000000001"
}
